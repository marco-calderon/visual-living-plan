{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visual-living-plan",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "living-plan",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PLANS", "class_name": "PlanObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlanObject"] }]
}
