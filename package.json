{
  "name": "visual-living-plan",
  "version": "2.19.1",
  "description": "Agent-authored living plans with human interaction, live updates, and a swappable execution canvas",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "bin": {
    "live-plan": "./dist/cli.js",
    "visual-living-plan": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs/changelogs",
    "DESIGN.md",
    "skills",
    "examples",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-calderon/visual-living-plan.git"
  },
  "bugs": {
    "url": "https://github.com/marco-calderon/visual-living-plan/issues"
  },
  "homepage": "https://github.com/marco-calderon/visual-living-plan#readme",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "prepack": "npm run build",
    "install:global": "npm run build && npm install -g .",
    "icons": "node scripts/pwa-icons/generate.mjs",
    "build:client": "vite build --config vite.client.config.ts",
    "build:shell-worker": "bun build src/shellWorker.ts --outfile=src/shellWorker.js --target=browser --format=esm --banner '// Generated from src/shellWorker.ts. Do not edit.'",
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "host": "npm run dev",
    "host:migrate": "wrangler d1 migrations apply living-plan --local",
    "serve": "bun src/cli.ts serve",
    "review": "bun src/cli.ts review",
    "wait": "bun src/cli.ts wait",
    "execution": "bun src/cli.ts execution",
    "check": "bun src/cli.ts check",
    "processes": "bun src/cli.ts processes",
    "dashboard": "bun src/cli.ts dashboard",
    "tui": "bun src/cli.ts tui",
    "skills:install": "node scripts/install-skills.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "bun test ./test",
    "test:e2e": "bun run build:client && playwright test"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@journeyapps/wa-sqlite": "^1.7.2",
    "@semos-labs/glyph": "^0.2.10",
    "@tanstack/browser-db-sqlite-persistence": "^1.0.0-rc.1.1",
    "@tanstack/db": "^1.0.0-rc.1.1",
    "@tanstack/offline-transactions": "^1.2.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "elkjs": "^0.12.0",
    "elysia": "^1.4.30",
    "lucide-react": "^1.58.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.0",
    "sonner": "^2.0.8",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@lexical/link": "0.48.0",
    "@lexical/react": "0.48.0",
    "@lexical/rich-text": "0.48.0",
    "@lexical/selection": "0.48.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdxeditor/editor": "^4.5.0",
    "@panzoom/panzoom": "^4.6.2",
    "@pierre/diffs": "^1.6.4",
    "@pierre/highlights": "^0.4.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.4.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "estree-util-value-to-estree": "^3.5.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lexical": "0.48.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-markdown": "^2.2.1",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-mdxjs": "^3.0.0",
    "pele": "^1.6.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.156.0"
  }
}
