{
  "name": "visual-living-plan",
  "version": "0.1.0",
  "description": "Agent-authored living plans with human interaction, live updates, and a swappable execution canvas",
  "type": "module",
  "bin": {
    "live-plan": "./dist/cli.js",
    "living-plan": "./dist/cli.js",
    "visual-living-plan": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "examples",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-calderon/visual-living-plan.git"
  },
  "bugs": {
    "url": "https://github.com/marco-calderon/visual-living-plan/issues"
  },
  "homepage": "https://github.com/marco-calderon/visual-living-plan#readme",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "prepack": "npm run build",
    "build:client": "vite build",
    "dev": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve",
    "review": "tsx src/cli.ts review",
    "wait": "tsx src/cli.ts wait",
    "execution": "tsx src/cli.ts execution",
    "check": "tsx src/cli.ts check",
    "processes": "tsx src/cli.ts processes",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
