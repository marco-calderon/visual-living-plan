{
  "name": "visual-living-plan",
  "version": "1.7.2",
  "description": "Agent-authored living plans with human interaction, live updates, and a swappable execution canvas",
  "type": "module",
  "bin": {
    "live-plan": "./dist/cli.js",
    "living-plan": "./dist/cli.js",
    "visual-living-plan": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs/changelogs",
    "DESIGN.md",
    "skills",
    "examples",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-calderon/visual-living-plan.git"
  },
  "bugs": {
    "url": "https://github.com/marco-calderon/visual-living-plan/issues"
  },
  "homepage": "https://github.com/marco-calderon/visual-living-plan#readme",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "prepack": "npm run build",
    "install:global": "npm run build && npm install -g .",
    "build:client": "vite build --config vite.client.config.ts",
    "host": "vite dev --host 127.0.0.1 --port 3000",
    "host:migrate": "wrangler d1 migrations apply living-plan --local",
    "dev": "bun src/cli.ts",
    "serve": "bun src/cli.ts serve",
    "review": "bun src/cli.ts review",
    "wait": "bun src/cli.ts wait",
    "execution": "bun src/cli.ts execution",
    "check": "bun src/cli.ts check",
    "processes": "bun src/cli.ts processes",
    "dashboard": "bun src/cli.ts dashboard",
    "tui": "bun src/cli.ts tui",
    "skills:install": "node scripts/install-skills.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "test:e2e": "bun run build:client && playwright test"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "^1.4.0",
    "@semos-labs/glyph": "^0.2.10",
    "@tanstack/react-table": "^9.3.1",
    "drizzle-orm": "^0.45.4",
    "elkjs": "^0.12.0",
    "elysia": "^1.4.30",
    "lucide-react": "^1.58.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.0",
    "sonner": "^2.0.8",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@mdx-js/mdx": "^3.1.1",
    "@panzoom/panzoom": "^4.6.2",
    "@pierre/diffs": "^1.5.2",
    "@playwright/test": "^1.64.1",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "estree-util-value-to-estree": "^3.5.0",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "pele": "^1.6.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.156.0"
  }
}
