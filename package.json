{
  "name": "visual-living-plan",
  "version": "0.1.0",
  "description": "Agent-authored living plans with human interaction, live updates, and a swappable execution canvas",
  "type": "module",
  "bin": {
    "live-plan": "./dist/cli.js",
    "living-plan": "./dist/cli.js",
    "visual-living-plan": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "examples",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-calderon/visual-living-plan.git"
  },
  "bugs": {
    "url": "https://github.com/marco-calderon/visual-living-plan/issues"
  },
  "homepage": "https://github.com/marco-calderon/visual-living-plan#readme",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "prepack": "npm run build",
    "build:client": "vite build",
    "dev": "bun src/cli.ts",
    "serve": "bun src/cli.ts serve",
    "review": "bun src/cli.ts review",
    "wait": "bun src/cli.ts wait",
    "execution": "bun src/cli.ts execution",
    "check": "bun src/cli.ts check",
    "processes": "bun src/cli.ts processes",
    "dashboard": "bun src/cli.ts dashboard",
    "tui": "bun src/cli.ts tui",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20"
  },
  "dependencies": {
    "@semos-labs/glyph": "^0.2.10",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "react": "^19.3.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.5.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "mermaid": "^12.1.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
