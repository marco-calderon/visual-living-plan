{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visual-living-plan",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/entry.ts",
  // Set in production with `wrangler secret put`. Local workerd reads them from `.dev.vars`
  // (copy `.dev.vars.example`). PUBLIC_URL and the OAuth client ids/secrets are optional.
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "living-plan",
      "database_id": "cd368c54-8c6c-4144-89c0-cef49f2c7a39",
      "migrations_dir": "src/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PLANS", "class_name": "PlanObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlanObject"] }],
  "observability": {
    "enabled": true
  }
}
