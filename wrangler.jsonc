{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visual-living-plan",
  "account_id": "989c1a32b23f46d91839c0e4daf38acc",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/entry.ts",
  // Set in production with `wrangler secret put`. Local workerd reads them from `.dev.vars`
  // (copy `.dev.vars.example`). PUBLIC_URL and the OAuth client ids/secrets are optional.
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "living-plan",
      "database_id": "cd368c54-8c6c-4144-89c0-cef49f2c7a39",
      "migrations_dir": "src/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PLANS", "class_name": "PlanObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlanObject"] }],
  "observability": {
    "enabled": true
  },
  // `*` is one run of [a-z0-9-] in the hostname. A matching preview signs in
  // on its own origin while PUBLIC_URL stays the production origin.
  "vars": {
    "TRUSTED_ORIGINS": "https://*-visual-living-plan.mcalderon-code.workers.dev,https://*.plan.logspace.qzz.io"
  },
  // Preview deployments for pull requests (`wrangler preview` in Workers Builds).
  // They use the separate `living-plan-preview` D1 database and inherit the PUBLIC_URL secret.
  // `vars` and Durable Object bindings are not inherited, so both are set again here.
  // Each Preview also gets its own empty PlanObject storage. Nothing a Preview writes
  // reaches production.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "PLANS", "class_name": "PlanObject" }]
    },
    "vars": {
      "TRUSTED_ORIGINS": "https://*-visual-living-plan.mcalderon-code.workers.dev,https://*.plan.logspace.qzz.io"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "living-plan-preview",
        "database_id": "8032bdc3-3b3e-4381-9b9c-a93837d244c8",
        "migrations_dir": "src/migrations"
      }
    ]
  }
}
