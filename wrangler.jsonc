{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visual-living-plan",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/entry.ts",
  // Local workerd only. Production sets BETTER_AUTH_SECRET with `wrangler secret put`.
  "vars": {
    "BETTER_AUTH_SECRET": "local-dev-secret-at-least-32-characters"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "living-plan",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "src/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PLANS", "class_name": "PlanObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlanObject"] }]
}
