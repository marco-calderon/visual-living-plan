{
  "include": [
    "src/entry.ts",
    "src/router.tsx",
    "src/routeTree.gen.ts",
    "src/PlanShell.tsx",
    "src/HostBar.tsx",
    "src/bindPlanChrome.ts",
    "src/planFns.ts",
    "src/authClient.ts",
    "src/cloudflare.d.ts",
    "src/routes/**/*.ts",
    "src/routes/**/*.tsx"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node", "vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
